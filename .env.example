# Confluence Configuration
CONFLUENCE_BASE_URL=https://your-confluence-domain.atlassian.net # Or your self-hosted URL
CONFLUENCE_USERNAME=your_email@example.com # Your email used for Confluence login
CONFLUENCE_PAT=your_confluence_personal_access_token
CONFLUENCE_SPACE_KEY=YOUR_SPACE_KEY # The key of the space you want to index

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434/api/embeddings # Used by the ETL script
OLLAMA_EMBEDDING_MODEL=all-minilm:l6-v2 # Used by ETL script (vector size, API) AND by docker-compose to pull the model
OLLAMA_HOST_PORT=11434 # Host port for Ollama service

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200 # Node URL for the ETL script
ELASTICSEARCH_INDEX_NAME=confluence_embeddings # Index name for the ETL script
ELASTICSEARCH_HOST_PORT=9200 # Host port for Elasticsearch HTTP
# ELASTICSEARCH_TRANSPORT_PORT=9300 # Optional: Host port for Elasticsearch Transport (if needed, e.g. for clustering)
# ELASTICSEARCH_USERNAME=elastic # Optional: Basic Auth username, if X-Pack security is enabled
# ELASTICSEARCH_PASSWORD=yoursecurepassword # Optional: Basic Auth password, if X-Pack security is enabled

# Search Configuration (Optional)
# If SEARCH_QUERY is set, the script will run in search mode instead of ETL mode.
# SEARCH_QUERY="your search query here"

# Testing Configuration
USE_FIXTURE_DATA=false # Set to true to use stubbed Confluence data for testing without live access
