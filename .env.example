# Confluence Configuration
CONFLUENCE_BASE_URL=https://your-confluence-domain.atlassian.net # Or your self-hosted URL
CONFLUENCE_USERNAME=your_email@example.com # Your email used for Confluence login
CONFLUENCE_PAT=your_confluence_personal_access_token
CONFLUENCE_SPACE_KEY=YOUR_SPACE_KEY # The key of the space you want to index

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434/api/embeddings # Used by the ETL script
OLLAMA_EMBEDDING_MODEL=all-minilm:l6-v2 # Used by the ETL script to determine vector size and passed to Ollama API
OLLAMA_MODEL_TAG=all-minilm:l6-v2 # Used by docker-compose to pull the model
OLLAMA_HOST_PORT=11434 # Host port for Ollama service

# Qdrant Configuration
QDRANT_URL=http://localhost:6333 # Used by the ETL script
QDRANT_COLLECTION_NAME=confluence_embeddings
QDRANT_HOST_HTTP_PORT=6333 # Host port for Qdrant HTTP
QDRANT_HOST_GRPC_PORT=6334 # Host port for Qdrant gRPC

# Testing Configuration
USE_FIXTURE_DATA=false # Set to true to use stubbed Confluence data for testing without live access

# Optional: Qdrant API Key if you enable authentication in Qdrant
# QDRANT_API_KEY=your_qdrant_api_key
