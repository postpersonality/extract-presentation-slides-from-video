USE_FIXTURE_DATA=true
CONFLUENCE_BASE_URL=http://fake-confluence-url.com
CONFLUENCE_USERNAME=fakeuser
CONFLUENCE_PAT=fakepat
CONFLUENCE_SPACE_KEY=TESTSPACE

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434/api/embeddings # For script running on host
OLLAMA_EMBEDDING_MODEL=all-minilm:l6-v2 # For script logic (e.g. vector size)
OLLAMA_MODEL_TAG=all-minilm:l6-v2 # For docker-compose pull
OLLAMA_HOST_PORT=11434 # For docker-compose port mapping

# Qdrant Configuration
QDRANT_URL=http://localhost:6333 # For script running on host
QDRANT_COLLECTION_NAME=confluence_embeddings
QDRANT_HOST_HTTP_PORT=6333 # For docker-compose port mapping
QDRANT_HOST_GRPC_PORT=6334 # For docker-compose port mapping
